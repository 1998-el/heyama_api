# ============================================
# ENVIRONNEMENT
# ============================================
NODE_ENV=development

# ============================================
# APPLICATION
# ============================================
PORT=5000
SOCKET_PORT=3001

# URL du frontend (pour CORS, OAuth redirects, liens emails)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# MONGODB
# ============================================
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# ============================================
# AUTHENTIFICATION JWT + OAUTH
# ============================================
JWT_SECRET=change-me-in-production-avec-une-cle-secrete-longue

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/callback/facebook

# ============================================
# BACKBLAZE B2 - Stockage images
# ============================================
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_PUBLIC_URL=https://f005.backblazeb2.com/file/<BUCKET>
B2_REGION=us-east-005

# ============================================
# EMAIL (Resend) - Notifications
# ============================================
RESEND_API_KEY=
EMAIL_FROM=noreply@heyama.app

# ============================================
# FIREBASE - Temps réel / Éditeur collaboratif
# ============================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_URL=

# ============================================
# CORS / FRONTENDS AUTORISÉS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,https://heyama-portal.vercel.app,https://heyama-api.vercel.app

# ============================================
# RATE LIMITING (optionnel, selon middleware)
# ============================================
THROTTLE_TTL=1000
THROTTLE_LIMIT=10
